APP_ENV=development
DATABASE_URL=postgresql+asyncpg://fairbench:fairbench_dev_password@localhost:5432/fairbench
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fairbench
MINIO_SECRET_KEY=fairbench_minio_password
MINIO_BUCKET=fairbench-assets
MINIO_SECURE=false
AGNES_API_URL=https://api.example.com/v1/face-attributes
AGNES_API_KEY=
AGNES_AUTH_SCHEME=bearer
AGNES_AUTH_HEADER=Authorization
AGNES_PROVIDER_MODE=multipart_attributes  # multipart_attributes | openai_vision
AGNES_MODEL=agnes-2.0-flash
AGNES_IMAGE_FIELD=image
AGNES_RESPONSE_AGE_PATH=age_group
AGNES_RESPONSE_GENDER_PATH=gender
AGNES_RESPONSE_ETHNICITY_PATH=ethnicity
AGNES_RESPONSE_CONFIDENCE_PATH=confidence
AGNES_TIMEOUT_SECONDS=15
AGNES_MAX_RETRIES=2
AGNES_MAX_CONCURRENCY=4
API_SECRET_TTL_SECONDS=86400
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_EXPIRE_MINUTES=60
LOCAL_SINGLE_USER_MODE=true
LOCAL_ADMIN_EMAIL=local-admin@fairbench.local
LOCAL_ADMIN_DISPLAY_NAME=Local Regulatory Administrator
SEED_DEMO_DATA=false
